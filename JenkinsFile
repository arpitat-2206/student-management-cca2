
pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                echo 'Checking out Student Management System'
                checkout scm
            }
        }

        stage('Check Files') {
            steps {
                sh 'ls -la'
                sh 'test -f app.py'
                sh 'test -f Dockerfile'
                sh 'test -f requirements.txt'
                echo 'All required project files are present'
            }
        }

        stage('Build Docker Image') {
            steps {
                sh 'docker build -t student-management-cca2 .'
            }
        }

        stage('Deployment Check') {
            steps {
                sh 'docker ps'
                echo 'Docker build and deployment check completed'
            }
        }
    }
}
